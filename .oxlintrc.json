{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "dist",
    "node_modules",
    ".wrangler",
    "worker-configuration.d.ts",
    "public",
    ".agents/skills/*/assets",
    ".claude/skills/*/assets",
    ".wt"
  ],
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    // neverthrow がテスト用に提供する API。この2つだけ許可する
    "no-underscore-dangle": ["error", { "allow": ["_unsafeUnwrap", "_unsafeUnwrapErr"] }]
  },
  "env": {
    "builtin": true
  }
}
