{
  "name": "my-cloudflare-workers-template",
  "private": true,
  "description": "A template for building a React application with Vite, Hono, and Cloudflare Workers",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "cf-typegen": "wrangler types",
    "check": "pnpm lint && pnpm fmt:check && vite build && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "dev": "vite",
    "lint": "oxlint && steiger ./src/react-app && depcruise src",
    "lint:fix": "oxlint --fix && steiger ./src/react-app --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "skills:check": "node scripts/check-skill-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "pnpm run build && vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint:deps": "depcruise src",
    "deps:graph": "depcruise src --output-type dot"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/zod-validator": "^0.9.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.29",
    "hono": "4.13.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.18.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.8",
    "@storybook/tanstack-react": "^10.5.8",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.32",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dependency-cruiser": "^18.2.0",
    "lucide-react": "^1.31.0",
    "mockdate": "^3.0.5",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "steiger": "^0.6.0",
    "storybook": "^10.5.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "wrangler": "4.125.0"
  },
  "packageManager": "pnpm@11.20.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
