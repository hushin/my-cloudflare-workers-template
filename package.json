{
  "name": "my-cloudflare-workers-template",
  "private": true,
  "description": "A template for building a React application with Vite, Hono, and Cloudflare Workers",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "cf-typegen": "wrangler types",
    "check": "pnpm lint && pnpm fmt:check && vite build && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "dev": "vite",
    "lint": "oxlint && steiger ./src/react-app && depcruise src",
    "lint:fix": "oxlint --fix && steiger ./src/react-app --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "skills:check": "node scripts/check-skill-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "pnpm run build && vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint:deps": "depcruise src",
    "deps:graph": "depcruise src --output-type dot",
    "postinstall": "msw init"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/zod-validator": "^0.9.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.40",
    "hono": "4.13.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@cloudflare/vite-plugin": "1.61.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-mcp": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/tanstack-react": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.41",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dependency-cruiser": "^18.4.0",
    "lucide-react": "^1.49.0",
    "mockdate": "^3.0.5",
    "msw": "^3.0.2",
    "msw-storybook-addon": "^3.0.3",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "playwright": "^1.63.0",
    "steiger": "^0.7.0",
    "storybook": "^10.6.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.9.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "wrangler": "4.142.0"
  },
  "packageManager": "pnpm@12.3.4",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
