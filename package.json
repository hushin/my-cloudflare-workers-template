{
  "name": "my-cloudflare-workers-template",
  "private": true,
  "description": "A template for building a React application with Vite, Hono, and Cloudflare Workers",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "cf-typegen": "wrangler types",
    "check": "pnpm lint && pnpm fmt:check && vite build && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "dev": "vite",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "pnpm run build && vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/zod-validator": "^0.9.0",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "hono": "4.12.31",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "shadcn": "^4.13.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@cloudflare/vite-plugin": "1.15.3",
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.3",
    "@storybook/tanstack-react": "^10.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.22",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "mockdate": "^3.0.5",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^2.0.7",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.25.0",
    "playwright": "^1.61.1",
    "storybook": "^10.5.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.10",
    "wrangler": "4.112.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
